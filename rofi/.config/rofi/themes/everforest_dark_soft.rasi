/**
 * Everforest Dark Soft theme
 * Palette source: sainnhe/everforest, upstream palette.md; commit 85a86eb.
 */

* {
    base03: #1e2326; base02: #3a464c; base01: #7a8478; base00: #859289;
    base0: #d3c6aa; base1: #9da9a0; base2: #4d5960; base3: #1e2326;
    yellow: #dbbc7f; orange: #e69875; red: #e67e80; magenta: #d699b6;
    violet: #d699b6; blue: #7fbbb3; cyan: #83c092; green: #a7c080;
    background: #333c43; background-alt: #3a464c; foreground: #d3c6aa;
    selected: #a7c080; active: #83c092; urgent: #e67e80;
    background-color: transparent; text-color: @foreground;
    border-color: #4d5960; separatorcolor: #424e54;
}

@import "styles.rasi"
