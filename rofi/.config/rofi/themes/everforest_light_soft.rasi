/**
 * Everforest Light Soft theme
 * Palette source: sainnhe/everforest, upstream palette.md; commit 85a86eb.
 */

* {
    base03: #1e2326; base02: #eae4ca; base01: #a6b0a0; base00: #939f91;
    base0: #5c6a72; base1: #829181; base2: #d8d3ba; base3: #1e2326;
    yellow: #dfa000; orange: #f57d26; red: #f85552; magenta: #df69ba;
    violet: #df69ba; blue: #3a94c5; cyan: #35a77c; green: #8da101;
    background: #f3ead3; background-alt: #eae4ca; foreground: #5c6a72;
    selected: #8da101; active: #35a77c; urgent: #f85552;
    background-color: transparent; text-color: @foreground;
    border-color: #d8d3ba; separatorcolor: #e4ddc3;
}

@import "styles.rasi"
