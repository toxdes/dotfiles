[global]
    font = "Berkeley Mono 14"
    enable_posix_regex = true

    # Padding
    padding = 12
    horizontal_padding = 20
    text_icon_padding = 12

    # Icons
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Light, candy-icons"
    default_icon = notification-active
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # Layout
    width = 360
    height = (0, 300)
    notification_limit = 5
    origin = top-right
    follow = mouse
    offset = (12, 30)
    separator_color = frame
    frame_width = 3
    gap_size = 0
    separator_height = 2
    corner_radius = 4
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    word_wrap = true
    ignore_newline = false
    idle_threshold = 120

    # Misc
    browser = /usr/bin/xdg-open
    markup = full
    format = "<b>%s</b>\n<span font_desc='Berkeley Mono 12'>%b</span>"

# Color scheme: everforest_dark_hard (active)
# To switch, comment out the active three sections and uncomment one complete
# alternative palette below. Keep exactly one palette active.
[urgency_low]
    background = "#272e33"
    foreground = "#d3c6aa"
    highlight = "#a7c080"
    frame_color = "#414b50"
    timeout = 6

[urgency_normal]
    background = "#272e33"
    foreground = "#d3c6aa"
    highlight = "#7fbbb3"
    frame_color = "#7fbbb3"
    timeout = 8

[urgency_critical]
    background = "#272e33"
    foreground = "#d3c6aa"
    highlight = "#e67e80"
    frame_color = "#e67e80"
    timeout = 0

